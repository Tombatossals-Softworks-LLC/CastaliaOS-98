# =====================================================================
#  CastaliaOS 98 PE - DOS product build (Open Watcom, wmake)
#
#  Builds the real 32-bit DOS/4GW executables from the SAME portable upper
#  stack plus the DOS/VESA platform backend (src/platform/dos). Run under an
#  Open Watcom environment (owsetenv) with:
#
#      wmake -f Makefile.dos
#
#  Outputs (in dist/cdroot/CASTALIA/BIN):
#      CASTALIA.EXE   - the graphical desktop
#      CBOOT.EXE      - the safe launcher AUTOEXEC.BAT calls
#
#  Notes:
#   - Target: 386+ flat protected mode via the DOS/4GW extender (DOS4GW.EXE
#     must accompany the binaries; see docs/BUILDING.md for licensing).
#   - CASTALIA_DOS selects the DOS backend; the host backend is excluded.
#   - This makefile requires the Open Watcom toolchain and is not exercised
#     by the portable host build. Validation happens on QEMU/Bochs/hardware
#     per docs/TESTING.md.
# =====================================================================

CC  = wcc386
LD  = wlink
# -I$(%WATCOM)/h puts Open Watcom's own C headers (dos.h, direct.h, i86.h, ...)
# on the search path explicitly, so the build works whether or not the INCLUDE
# environment variable was set by owsetenv (e.g. a bare CI runner where the
# setup action exports WATCOM + PATH but not INCLUDE).
CFLAGS = -bt=dos -mf -5r -oaxt -w3 -dCASTALIA_DOS -Iinclude -Isrc/apps -Isrc/platform/dos -I$(%WATCOM)/h
OUTDIR = dist/cdroot/CASTALIA/BIN

# ---- portable upper stack (identical to the host build) --------------
CORE_OBJS = &
  sys_log.obj sys_str.obj sys_mem.obj sys_time.obj sys_crash.obj &
  snd_common.obj clip.obj &
  cfg_ini.obj settings.obj &
  capp.obj capp_scan.obj capp_loader.obj capp_loader_io.obj &
  capp_host_wm.obj capp_sample.obj net_util.obj &
  gfx_rect.obj gfx_surface.obj gfx_draw.obj gfx_blit.obj gfx_font.obj &
  gfx_font_data.obj gfx_font_spleen.obj gfx_palette.obj gfx_bmp.obj gfx_bmp_io.obj &
  wm_window.obj wm_frame.obj wm_dispatch.obj wm_snap.obj wm_move.obj &
  ui_button.obj ui_hotpaint.obj ui_menu.obj ui_edit.obj ui_dialog.obj ui_controls.obj &
  ui_scroll.obj ui_path.obj ui_filedlg.obj &
  sh_kmove.obj icon_nav.obj sh_theme.obj sh_theme_io.obj sh_cursor.obj sh_desktop.obj sh_iconpack.obj sh_taskbar.obj &
  sh_launcher.obj sh_context.obj sh_shutdown.obj sh_core.obj sh_anim.obj &
  sh_logo.obj sh_splash.obj sh_saver.obj sh_tooltip.obj &
  app_window.obj app_sysinfo.obj app_fileman.obj &
  app_notepad.obj app_calc.obj app_logview.obj app_control.obj &
  app_taskman.obj app_paint.obj app_view.obj &
  app_about.obj app_bench.obj app_media.obj wav.obj &
  app_clock.obj app_charmap.obj app_props.obj app_net.obj app_theme.obj app_help.obj &
  app_solitaire.obj app_console.obj app_welcome.obj &
  calc_core.obj sol_core.obj wrap_core.obj cmap_core.obj fsize_core.obj ring_core.obj fc_core.obj rev_core.obj trash_core.obj card_draw.obj undo_core.obj app_freecell.obj app_reversi.obj mines_core.obj app_mines.obj &
  sheet_core.obj app_sheet.obj &
  write_core.obj app_write.obj office_ui.obj &
  eq_core.obj agenda_core.obj paint_core.obj hex_core.obj thumb_core.obj assoc.obj hist_core.obj &
  map_core.obj app_diskuse.obj app_compare.obj diff_core.obj grep_core.obj ren_core.obj ren_batch.obj app_archive.obj app_hex.obj lzss_core.obj cz_file.obj lastgood.obj cpu_core.obj mach_core.obj cal_core.obj sys_le.obj sys_home.obj vbe_pick.obj vbe_report.obj vbe_bank.obj sw_core.obj car_core.obj net_stack.obj

# ---- DOS platform backend --------------------------------------------
DOS_OBJS = &
  plat_dos.obj vesa.obj mouse.obj keyboard.obj dos_proc.obj dos_dpmi.obj &
  snd_dos.obj snd_blaster.obj net_pkt.obj

SHELL_OBJS = $(CORE_OBJS) $(DOS_OBJS) main.obj

all: $(OUTDIR)/castalia.exe $(OUTDIR)/cboot.exe $(OUTDIR)/install.exe .SYMBOLIC

# Link directly into the output directory (which ships in the repo). This
# avoids DOS-only `copy`/`mkdir` recipe commands, so the makefile builds under
# Open Watcom on a Linux host as well as on DOS/Windows. wlink needs wstub.exe
# on the PATH ($WATCOM/binw); see docs/BUILDING.md.
$(OUTDIR)/castalia.exe: $(SHELL_OBJS)
	$(LD) system dos4g name $^@ file { $(SHELL_OBJS) }

$(OUTDIR)/cboot.exe: cboot.obj
	$(LD) system dos4g name $^@ file { cboot.obj }

$(OUTDIR)/install.exe: install_core.obj install_main.obj
	$(LD) system dos4g name $^@ file { install_core.obj install_main.obj }

# ---- compile rules (explicit paths -> flat .obj names) ---------------
sys_log.obj:     src/sys/sys_log.c
